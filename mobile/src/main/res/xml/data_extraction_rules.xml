<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Google account (cloud) backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="workouts/" />
        <include domain="file" path="ecg/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="workouts/" />
        <include domain="file" path="ecg/" />
    </device-transfer>
</data-extraction-rules>
